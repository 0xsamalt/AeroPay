# Demo Merchant API Configuration

# Your merchant wallet address (registered in MerchantRegistry)
MERCHANT_ADDRESS=0xBf150DFD114350F37f5967cA859Fb0366133CABf

# Where you want to receive payments
SETTLEMENT_ADDRESS=0xBf150DFD114350F37f5967cA859Fb0366133CABf

#USDC base sepolia
TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Base Sepolia Chain ID
CHAIN_ID=84532

# Price per request (in token units with decimals)
# Example: 50000 = 0.05 USDC (6 decimals)
PRICE=50000

# Flash Gateway URL (will be localhost:3000 when you build it)
GATEWAY_URL=http://localhost:3000

# Skip validation in development (accepts any Flash header)
SKIP_VALIDATION=true

# Node environment
NODE_ENV=development